{
  "buildCommand": "pnpm build:demo",
  "outputDirectory": "demo-dist",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/studio.ts": {
      "maxDuration": 300
    },
    "api/asset.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
