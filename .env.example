NODE_ENV=development

# Vercel production workflow
# Created automatically when a private Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
# Choose a strong operator passphrase (12+ characters).
PORTRAIT_ACCESS_KEY=
# Server-side only. Never expose this with a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Original Cloudflare/Vinext implementation
DATABASE_URL=

PORTRAIT_PROVIDER=mock
PORTRAIT_PROVIDER_API_KEY=
PORTRAIT_PROVIDER_BASE_URL=https://api.openai.com/v1
PORTRAIT_PROVIDER_MODEL=gpt-image-2
PORTRAIT_PROVIDER_TIMEOUT_MS=120000
PORTRAIT_PROVIDER_MAX_RETRIES=2

SOURCE_IMAGE_ANALYZER=mock
QUALITY_JUDGE_PROVIDER=mock

OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
ASSET_SIGNING_SECRET=

JOB_QUEUE_PROVIDER=memory
REDIS_URL=

PORTRAIT_DEFAULT_PRICE_FEN=990
PORTRAIT_CURRENCY=CNY
PORTRAIT_DEFAULT_GENERATION_COUNT=4
PORTRAIT_MAX_BATCH_RETRIES=1
PORTRAIT_MAX_SINGLE_CANDIDATE_RETRIES=2

MAX_UPLOAD_SIZE_MB=15
CUSTOMER_PREVIEW_MAX_DIMENSION=640
ADMIN_PREVIEW_MAX_DIMENSION=1200
ENABLE_CUSTOMER_PREVIEW_WATERMARK=true
CUSTOMER_PREVIEW_WATERMARK_TEXT=CATV Portrait · Preview

UNFINISHED_ORDER_RETENTION_DAYS=14
COMPLETED_ORDER_IMAGE_RETENTION_DAYS=7
SIGNED_URL_EXPIRATION_MINUTES=15

PORTRAIT_ADMIN_EMAIL=
PORTRAIT_ADMIN_PASSWORD_HASH=

ENABLE_PORTRAIT_PUBLIC_PAGE=true
ENABLE_PORTRAIT_SELF_SERVICE=false
ENABLE_PORTRAIT_ONLINE_PAYMENT=false
